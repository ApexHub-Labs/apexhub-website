# GA4 Measurement ID (starts with "G-"). GA only loads in production.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Public URL the site is served from — drives canonical, OG, sitemap & robots.
NEXT_PUBLIC_SITE_URL=https://apexhub-labs.vercel.app
# Optional: Search Console HTML-tag verification code (the content="" value).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Resend API key used by the contact form (server-only, keep secret).
RESEND_API_KEY=re_xxxxxxxxxxxx
# Inbox that receives contact form enquiries.
CONTACT_TO_EMAIL=you@example.com
# Optional: sender address; needs a domain verified in Resend.
CONTACT_FROM_EMAIL=
